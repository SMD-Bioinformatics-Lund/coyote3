  {
    "aspc_id": "demo_e2e_hematology_base_testing",
    "display_name": "Synthetic hematology",
    "asp_group": "hematology",
    "asp_category": "dna",
    "description": "Demo ASP config for first-run DNA sample workflows",
    "reference_genome": "GRCh38",
    "platform": "Illumina",
    "environment": "testing",
    "version": 1,
    "is_active": true,
    "analysis_types": [
      "SNV",
      "CNV",
      "CNV_PROFILE",
      "COVERAGE",
      "TRANSLOCATION",
      "HRD",
      "MSI",
      "TMB",
      "PGX"
    ],
    "filters": {
      "somatic": {
        "snv": {
          "max_freq": 1,
          "min_freq": 0.03,
          "max_control_freq": 0.05,
          "max_popfreq": 0.01,
          "min_depth": 100,
          "min_alt_reads": 5,
          "vep_consequences": [
            "splicing",
            "stop_gained",
            "stop_lost",
            "start_lost",
            "frameshift",
            "inframe_indel",
            "missense",
            "other_coding"
          ],
          "snvlists": []
        },
        "cnv": {
          "min_cnv_size": 100,
          "max_cnv_size": 1000000,
          "cnv_loss_cutoff": -0.3,
          "cnv_gain_cutoff": 0.3,
          "cnveffects": [
            "gain",
            "loss"
          ],
          "cnvlists": []
        },
        "coverage": {
          "warn_cov": 500,
          "error_cov": 100
        },
        "translocation": {
          "fusionlists": [],
          "adhoc_genes": {}
        }
      }
    },
    "reporting": {
      "report_sections": [
        "SNV",
        "CNV",
        "TRANSLOCATION",
        "HRD",
        "MSI",
        "TMB"
      ],
      "report_header": "SYNTHETIC \u2014 NOT FOR CLINICAL USE",
      "report_method": "Artificial fixture evidence",
      "report_description": "Workflow verification",
      "language": "en",
      "plots_path": "/tmp",
      "report_folder": "demo-e2e"
    },
