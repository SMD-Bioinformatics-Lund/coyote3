ARG PYTHON_BASE_IMAGE=python:3.14.7-slim-bookworm
FROM ${PYTHON_BASE_IMAGE} AS coyote4_dev_runtime_base
ARG PYTHON_BASE_IMAGE

LABEL base_image="${PYTHON_BASE_IMAGE}"
LABEL about.home="https://github.com/SMD-Bioinformatics-Lund/coyote3"

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_PROGRESS_BAR=off
ARG GIT_COMMIT="unknown"
ARG BUILD_TIME="unknown"
ARG COYOTE4_UID=10001
ARG COYOTE4_GID=10001
ENV GIT_COMMIT=${GIT_COMMIT}
ENV BUILD_TIME=${BUILD_TIME}

RUN apt-get update -o Acquire::Retries=5 && \
    apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
    curl \
    libxml2-dev libxslt1-dev zlib1g-dev libsasl2-dev libldap2-dev \
    build-essential libssl-dev libffi-dev libjpeg-dev libpq-dev \
    liblcms2-dev libblas-dev libatlas-base-dev libglib2.0-dev \
    libpango-1.0-0 less vim && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN apt-get update -o Acquire::Retries=5 && \
    apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
    libpangoft2-1.0-0 fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${COYOTE4_GID}" coyote4 && \
    useradd --uid "${COYOTE4_UID}" --gid coyote4 --create-home coyote4 && \
    mkdir -p ./logs ./redis_data && chown -R coyote4:coyote4 /app

FROM coyote4_dev_runtime_base AS coyote4_dev_api

EXPOSE 8001

COPY core/ ./core/
COPY api/ ./api/
COPY adapters/mongo/ ./adapters/mongo/
COPY scripts/ ./scripts/
COPY deploy/installer/ ./deploy/installer/
COPY tests/ ./tests/
COPY CHANGELOG.md README.md LICENSE.txt COPYRIGHT.txt NOTICE.txt ./
COPY LICENSING.md THIRD_PARTY_NOTICES.md ./
COPY services/atlas/ ./services/atlas/
COPY pyproject.toml MANIFEST.in package_build.py ./
COPY release.toml ./
RUN pip install --no-cache-dir --no-deps -e core -e . -e services/atlas
COPY .release/relay/ /opt/coyote-relay/
RUN python -c 'from pathlib import Path; from scripts.release.build_sdk import RelayArtifact; RelayArtifact(Path.cwd(), Path("/opt/coyote-relay")).validate()' && \
    pip install --no-cache-dir --no-deps /opt/coyote-relay/coyote_relay-*.whl && pip check

USER coyote4:coyote4

CMD ["python3", "-m", "uvicorn", "coyote_api.app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]

FROM coyote4_dev_api AS coyote4_dev_all
