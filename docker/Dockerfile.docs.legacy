ARG PYTHON_BASE_IMAGE=python:3.12-slim-bullseye
FROM ${PYTHON_BASE_IMAGE} AS mkdocs_builder

ENV PIP_PROGRESS_BAR=off
WORKDIR /app

COPY requirements-docs.txt mkdocs.yml ./
RUN pip install --no-cache-dir -r requirements-docs.txt

COPY docs/ ./docs/
COPY api/version.py ./api/version.py
COPY release.toml ./
COPY config/examples/center/contact.toml ./config/examples/center/contact.toml
ARG ENV_NAME=""
ARG ORGANIZATION_NAME=""
ENV ENV_NAME=${ENV_NAME}
ENV ORGANIZATION_NAME=${ORGANIZATION_NAME}
RUN mkdocs build --strict

FROM nginx:1.27-alpine
EXPOSE 8080
COPY docker/nginx/docs.conf /etc/nginx/conf.d/default.conf
COPY --from=mkdocs_builder /app/site/ /usr/share/nginx/html/
