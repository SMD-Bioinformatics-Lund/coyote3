ARG PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_BASE_IMAGE} AS mkdocs_builder

# Avoid pip's progress refresh thread on legacy container runtimes.
ENV PIP_PROGRESS_BAR=off

WORKDIR /app

COPY requirements-docs.txt mkdocs.yml ./
RUN pip install --no-cache-dir -r requirements-docs.txt

COPY docs/ ./docs/
COPY release.toml ./
COPY README.md CHANGELOG.md LICENSE.txt COPYRIGHT.txt NOTICE.txt pyproject.toml ./
COPY core/docs/ ./core/docs/
COPY core/README.md core/CHANGELOG.md core/LICENSE.txt core/COPYRIGHT.txt core/NOTICE.txt core/pyproject.toml ./core/
COPY api/docs/ ./api/docs/
COPY api/README.md api/CHANGELOG.md api/LICENSE.txt api/COPYRIGHT.txt api/NOTICE.txt api/pyproject.toml ./api/
COPY api/src/coyote_api/config/assets/coyote-api-logo.svg ./api/src/coyote_api/config/assets/coyote-api-logo.svg
COPY adapters/mongo/docs/ ./adapters/mongo/docs/
COPY adapters/mongo/README.md adapters/mongo/CHANGELOG.md adapters/mongo/LICENSE.txt adapters/mongo/COPYRIGHT.txt adapters/mongo/NOTICE.txt adapters/mongo/pyproject.toml ./adapters/mongo/
COPY services/relay/docs/ ./services/relay/docs/
COPY services/relay/src/coyote_relay/assets/ ./services/relay/src/coyote_relay/assets/
COPY services/relay/README.md services/relay/CHANGELOG.md services/relay/LICENSE.txt services/relay/COPYRIGHT.txt services/relay/NOTICE.txt services/relay/pyproject.toml ./services/relay/
COPY services/atlas/docs/ ./services/atlas/docs/
COPY services/atlas/src/coyote_atlas/assets/ ./services/atlas/src/coyote_atlas/assets/
COPY services/atlas/src/coyote_atlas/data/reference/NOTICE.txt services/atlas/src/coyote_atlas/data/reference/LICENSE.txt ./services/atlas/src/coyote_atlas/data/reference/
COPY services/atlas/README.md services/atlas/CHANGELOG.md services/atlas/LICENSE.txt services/atlas/COPYRIGHT.txt services/atlas/NOTICE.txt services/atlas/pyproject.toml ./services/atlas/
COPY services/demo/docs/ ./services/demo/docs/
COPY services/demo/src/coyote_demo/assets/ ./services/demo/src/coyote_demo/assets/
COPY services/demo/README.md services/demo/CHANGELOG.md services/demo/LICENSE.txt services/demo/COPYRIGHT.txt services/demo/NOTICE.txt services/demo/pyproject.toml ./services/demo/
COPY frontend/docs/ ./frontend/docs/
COPY frontend/README.md frontend/LICENSE.txt frontend/COPYRIGHT.txt frontend/NOTICE.txt frontend/package.json ./frontend/
COPY --from=center_config contact.toml ./api/src/coyote_api/config/examples/center/contact.toml
ARG ENV_NAME=""
ARG ORGANIZATION_NAME=""
ENV ENV_NAME=${ENV_NAME}
ENV ORGANIZATION_NAME=${ORGANIZATION_NAME}
RUN mkdocs build --strict

FROM nginx:1.27-alpine

EXPOSE 8080

COPY docker/nginx/docs.conf /etc/nginx/conf.d/default.conf
COPY --from=mkdocs_builder /app/site/ /usr/share/nginx/html/
