FROM node:22-alpine AS frontend_builder

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
COPY api/version.py /app/api/version.py

# Vite embeds these public, deployment-specific values in the generated assets.
ARG SCRIPT_NAME=""
ARG ORGANIZATION_NAME="Coyote3"
ARG LOCAL_TIME_ZONE="UTC"
ARG GENS_URI=""
ARG IGV_URI=""
ENV SCRIPT_NAME=${SCRIPT_NAME} \
    ORGANIZATION_NAME=${ORGANIZATION_NAME} \
    LOCAL_TIME_ZONE=${LOCAL_TIME_ZONE} \
    GENS_URI=${GENS_URI} \
    IGV_URI=${IGV_URI}

RUN npm run build

FROM nginx:1.27-alpine

EXPOSE 3000

COPY docker/nginx/render-frontend-config.sh /usr/local/bin/render-frontend-config.sh
COPY --from=frontend_builder /app/frontend/dist/ /usr/share/nginx/html/

ENTRYPOINT ["/usr/local/bin/render-frontend-config.sh"]
CMD ["nginx", "-g", "daemon off;"]
