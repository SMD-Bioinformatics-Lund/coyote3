        "section_order": 200,
        "block_order": 10,
        "show_heading": true,
        "match_strategy": "first_match",
        "rules": [
          {
            "rule_id": "demo_dna_tiered_finding",
            "name": "Tiered finding",
            "order": 10,
            "enabled": true,
            "condition": {
              "type": "predicate",
              "fact": "finding.tier",
              "operator": "in",
              "value": [1, 2, 3]
            },
            "output": [
              {
                "type": "fact",
                "path": "finding.gene",
                "formatter": "gene_symbol",
                "missing": "error"
              },
              { "type": "text", "value": " contains a reportable small variant." }
            ],
            "references": []
          }
        ]
      }
    ],
