# Connection overrides for host-run local development; load after example.env.
# Start/initialize an authenticated local replica set independently. No Docker Mongo profile.
# Provision this runtime user and the restricted identity role before installation.
# URI passwords must match the server account and must be percent-encoded.
# Reference: docs/architecture/mongodb-topology.md#single-instance-development
COYOTE3_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote3-rs'
IDENTITY_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote3-rs'
KNOWLEDGEBASE_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote3-rs'
BAM_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote3-rs'
COYOTE3_DB='coyote3_dev'
IDENTITY_DB='coyote3_identity_dev'
KNOWLEDGEBASE_DB='coyote3_knowledgebases'
BAM_DB='bam_dev'
# For Docker clients of this host service, use host.docker.internal instead of
# 127.0.0.1 and advertise a replica-set member address reachable by those clients.
