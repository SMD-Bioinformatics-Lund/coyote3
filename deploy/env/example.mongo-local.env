# Connection overrides for host-run local development; load after example.env.
# Start/initialize the local replica set independently. No Docker Mongo profile.
# Reference: docs/architecture/mongodb_topology.md#single-instance-development
COYOTE3_MONGO_URI='mongodb://127.0.0.1:27017/?replicaSet=coyote3-rs'
IDENTITY_MONGO_URI='mongodb://127.0.0.1:27017/?replicaSet=coyote3-rs'
KNOWLEDGEBASE_MONGO_URI='mongodb://127.0.0.1:27017/?replicaSet=coyote3-rs'
BAM_MONGO_URI='mongodb://127.0.0.1:27017/?replicaSet=coyote3-rs'
COYOTE3_DB='coyote3_dev'
IDENTITY_DB='coyote3_identity_dev'
KNOWLEDGEBASE_DB='coyote3_knowledgebases'
BAM_DB='bam_dev'
# For Docker clients of this host service, use host.docker.internal instead of
# 127.0.0.1 and advertise a replica-set member address reachable by those clients.
