# Connection overrides for host-run local development; load after example.env.
# Start an authenticated single-member replica set independently, natively or in Docker.
# directConnection supports a published Docker port without resolving container member names.
# For a multi-member deployment, use reachable advertised members and omit directConnection.
# Provision this runtime user and the restricted identity role before installation.
# URI passwords must match the server account and must be percent-encoded.
# Reference: docs/architecture/mongodb-topology.md#single-instance-development
COYOTE4_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote4-rs&directConnection=true'
IDENTITY_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote4-rs&directConnection=true'
KNOWLEDGEBASE_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote4-rs&directConnection=true'
BAM_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=coyote4-rs&directConnection=true'
COYOTE4_DB='coyote4_dev'
IDENTITY_DB='coyote4_identity_dev'
KNOWLEDGEBASE_DB='coyote4_knowledgebases'
BAM_DB='bam_dev'
# For Docker clients of this host service, use host.docker.internal instead of
# 127.0.0.1 and advertise a replica-set member address reachable by those clients.
