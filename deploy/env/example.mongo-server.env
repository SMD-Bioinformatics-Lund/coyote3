# MongoDB server deployment only. Not consumed by API, UI, or workers.
# Copy to .coyote3_dev_mongo_env (or a center-specific *mongo_env file).
# Replace credentials before startup. Never commit a completed env file.
# Shared names below must match the application deployment for initial grants.
COYOTE3_APP_NETWORK='coyote3-prod-app-net'
COYOTE3_DB='coyote3_dev'
IDENTITY_DB='coyote3_identity_dev'
KNOWLEDGEBASE_DB='coyote3_knowledgebases'
BAM_DB='bam_dev'

# App MongoDB accounts, replica set, listener, storage, and resource limits.
# Set MONGO_UID/MONGO_GID to the intended host database owner.
# Backup storage is optional and used only with the backup mount overlay.
MONGO_ROOT_USERNAME='coyote3_root'
MONGO_ROOT_PASSWORD='CHANGE_ME_ROOT_PASSWORD'
MONGO_APP_USER='coyote3_app'
MONGO_APP_PASSWORD='CHANGE_ME_APP_PASSWORD'
MONGO_REPLICA_SET_NAME='coyote3-rs'
MONGO_REPLICA_MEMBER_HOST='mongo-app:27017'
COYOTE3_MONGO_PORT='27017'
COYOTE3_MONGO_BIND_ADDRESS='127.0.0.1'
COYOTE3_MONGO_DATA_HOST_ROOT='/srv/coyote3/mongo/data'
COYOTE3_MONGO_KEYFILE_HOST_PATH='/srv/coyote3/mongo/keyfile'
MONGO_UID=
MONGO_GID=
MONGO_CONTAINER_MEM_LIMIT='8g'
MONGO_CONTAINER_CPU_LIMIT='4.0'
COYOTE3_MONGO_BACKUP_HOST_ROOT='/srv/coyote3/mongo/backups'

# Optional separate knowledgebase server (mongo-kb profile only).
KNOWLEDGEBASE_REPLICA_SET_NAME='coyote3-kb-rs'
KNOWLEDGEBASE_REPLICA_MEMBER_HOST='mongo-kb:27017'
KNOWLEDGEBASE_MONGO_ROOT_USERNAME='coyote3_kb_root'
KNOWLEDGEBASE_MONGO_ROOT_PASSWORD='CHANGE_ME_KB_ROOT_PASSWORD'
KNOWLEDGEBASE_MONGO_APP_USER='coyote3_reader'
KNOWLEDGEBASE_MONGO_APP_PASSWORD='CHANGE_ME_KB_PASSWORD'
KNOWLEDGEBASE_MONGO_KEYFILE_HOST_PATH='/srv/coyote3/mongo-kb/keyfile'
KNOWLEDGEBASE_MONGO_DATA_HOST_ROOT='/srv/coyote3/mongo-kb/data'
