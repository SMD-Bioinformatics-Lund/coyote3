# Load generator only. Do not copy application or MongoDB secrets into this file.
# The target URL and its expected deployment identity belong in config.json.
COYOTE3_LOAD_NETWORK=coyote3-loadtest-net
COYOTE3_LOAD_PORT=8089
# Override with the UID/GID owning the private input and results directories.
COYOTE3_LOAD_UID=1000
COYOTE3_LOAD_GID=1000
# Relative paths resolve from deploy/compose, not the current shell directory.
COYOTE3_LOAD_PRIVATE_DIR=../../.coyote3_load
COYOTE3_LOAD_RESULTS_DIR=../../load-results
COYOTE3_LOAD_MEM_LIMIT=512m
COYOTE3_LOAD_CPU_LIMIT=1.0
