# Load generator only. Do not copy application or MongoDB secrets into this file.
# The target URL and its expected deployment identity belong in config.json.
# Reference: docs/testing/load-and-capacity-testing.md#load-generator-environment-reference
COYOTE4_LOAD_NETWORK=coyote4-loadtest-net
COYOTE4_LOAD_PORT=8089
# Override with the UID/GID owning the private input and results directories.
COYOTE4_LOAD_UID=1000
COYOTE4_LOAD_GID=1000
# Relative paths resolve from deploy/compose, not the current shell directory.
COYOTE4_LOAD_PRIVATE_DIR=../../.coyote4_load
COYOTE4_LOAD_RESULTS_DIR=../../load-results
COYOTE4_LOAD_MEM_LIMIT=512m
COYOTE4_LOAD_CPU_LIMIT=1.0
