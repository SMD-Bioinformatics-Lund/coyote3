# Redis server only. Keep application connection URLs in the application env file.
ENV_NAME='development'
COYOTE4_APP_NETWORK='coyote4-dev-app-net'
REDIS_PASSWORD='CHANGE_ME_REDIS_SECRET'
COYOTE4_REDIS_BIND_ADDRESS='127.0.0.1'
COYOTE4_REDIS_PORT='6379'
COYOTE4_REDIS_VOLUME='coyote4-dev-redis-data'
# Native mode manages an already provisioned systemd unit, without sudo.
# COYOTE4_REDIS_UNIT='redis-server.service'
