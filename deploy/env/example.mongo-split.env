# Overrides loaded after a completed example.env; never deploy placeholder secrets.
# Application connection overrides only. Provision servers independently using
# example.mongo-server.env and profiles mongo and mongo-kb.
# Reference: docs/architecture/mongodb-topology.md#optional-docker-mongodb
# URI passwords must match the separately supplied provisioning credentials.
COYOTE4_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@mongo-app:27017/?authSource=admin&replicaSet=coyote4-rs'
IDENTITY_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@mongo-app:27017/?authSource=admin&replicaSet=coyote4-rs'
BAM_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@mongo-app:27017/?authSource=admin&replicaSet=coyote4-rs'
KNOWLEDGEBASE_MONGO_URI='mongodb://coyote4_reader:CHANGE_ME_KB_PASSWORD@mongo-kb:27017/?authSource=admin&replicaSet=coyote4-kb-rs'
COYOTE4_DB='coyote4'
IDENTITY_DB='coyote4_identity_prod'
KNOWLEDGEBASE_DB='coyote4_knowledgebases'
BAM_DB='coyote4_bam_prod'
ENV_NAME='production'
# The shared KB instance belongs to one platform stack. Other environment stacks
# use its reachable URI without starting another mongo-kb service.
