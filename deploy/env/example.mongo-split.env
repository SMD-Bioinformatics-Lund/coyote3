# Overrides loaded after a completed example.env; never deploy placeholder secrets.
# Include docker-compose.mongo.yml and enable profiles mongo and mongo-kb.
# Reference: docs/architecture/mongodb_topology.md#optional-docker-mongodb
# URI passwords must match the separately supplied provisioning credentials.
COYOTE3_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@mongo-app:27017/?authSource=admin&replicaSet=coyote3-rs'
IDENTITY_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@mongo-app:27017/?authSource=admin&replicaSet=coyote3-rs'
BAM_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@mongo-app:27017/?authSource=admin&replicaSet=coyote3-rs'
KNOWLEDGEBASE_MONGO_URI='mongodb://coyote3_reader:CHANGE_ME_KB_PASSWORD@mongo-kb:27017/?authSource=admin&replicaSet=coyote3-kb-rs'
COYOTE3_DB='coyote3'
IDENTITY_DB='coyote3_identity_prod'
KNOWLEDGEBASE_DB='coyote3_knowledgebases'
BAM_DB='bam_prod'
ENV_NAME='production'
MONGO_REPLICA_SET_NAME='coyote3-rs'
MONGO_REPLICA_MEMBER_HOST='mongo-app:27017'
KNOWLEDGEBASE_REPLICA_SET_NAME='coyote3-kb-rs'
KNOWLEDGEBASE_REPLICA_MEMBER_HOST='mongo-kb:27017'
KNOWLEDGEBASE_MONGO_ROOT_USERNAME='coyote3_kb_root'
KNOWLEDGEBASE_MONGO_ROOT_PASSWORD='CHANGE_ME_KB_ROOT_PASSWORD'
KNOWLEDGEBASE_MONGO_APP_USER='coyote3_reader'
KNOWLEDGEBASE_MONGO_APP_PASSWORD='CHANGE_ME_KB_PASSWORD'
KNOWLEDGEBASE_MONGO_KEYFILE_HOST_PATH='/srv/coyote3/mongo-kb/keyfile'
KNOWLEDGEBASE_MONGO_DATA_HOST_ROOT='/srv/coyote3/mongo-kb/data'
# The shared KB instance belongs to one platform stack. Other environment stacks
# use its reachable URI without starting another mongo-kb service.
