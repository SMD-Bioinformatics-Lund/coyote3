# Coyote3 environment template.
# Copy this file to the environment file consumed by your compose profile:
#   cp deploy/env/example.env .coyote3_dev_env
#   cp deploy/env/example.env .coyote3_stage_env
#   cp deploy/env/example.env .coyote3_test_env
#   cp deploy/env/example.env .coyote3_env
#
# Review the deployment values, database names, public URLs, and enabled
# integrations for each center. Replace every applicable placeholder secret.
# Local env files are ignored by git and must never be committed.
# Variable reference: docs/start_here/configuration.md#environment-variable-reference
# MongoDB server provisioning lives in deploy/env/example.mongo-server.env.

# Required deployment values
# --------------------------
# Use unique secrets per environment. Each MongoDB URI must be reachable from the API,
# worker, and beat containers. Create the application network before Compose
# starts. Data and log roots must exist and be writable by 10001:10001, unless
# COYOTE3_UID/COYOTE3_GID are deliberately overridden below.
COYOTE3_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote3-rs'
IDENTITY_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote3-rs'
KNOWLEDGEBASE_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote3-rs'
BAM_MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote3-rs'
SECRET_KEY='CHANGE_ME_SECRET_KEY'
INTERNAL_API_TOKEN='CHANGE_ME_INTERNAL_API_TOKEN'
PASSWORD_TOKEN_SALT='CHANGE_ME_PASSWORD_TOKEN_SALT'
REDIS_PASSWORD='CHANGE_ME_HEX_SECRET'
# Shared root; startup creates coyote3_dev/prod/test/stage according to ENV_NAME.
# Reports and ingest working directories live inside that environment directory.
COYOTE3_DATA_HOST_ROOT='/data/coyote3'
COYOTE3_LOGS_HOST_ROOT='/srv/coyote3/logs'
ERROR_EMAIL_GROUP='monitoring_group'
COYOTE3_APP_NETWORK='coyote3-prod-app-net'

# Supported application defaults
# ------------------------------
# Change ENV_NAME for test, validation, or production. Set SCRIPT_NAME only
# when publishing below a URL prefix. Compose requires PUBLIC_BASE_URL; Coyote3
# uses it for links outside a browser request, including password-reset email.

# Runtime identity
ENV_NAME='development'
# Daily log retention at midnight; compress logs older than seven days.
LOG_GZIP_AFTER_DAYS=7
COYOTE3_MAINTENANCE_HOUR=0
# Browser UI and API docs share the API's HttpOnly session cookie.
# Use a unique name per deployment on the same hostname (including different ports).
# Examples: coyote3_dev_api_session, coyote3_test_api_session,
# coyote3_stage_api_session, coyote3_prod_api_session.
API_SESSION_COOKIE_NAME='coyote3_dev_api_session'
COYOTE3_DB='coyote3_dev'
IDENTITY_DB='coyote3_identity_dev'
KNOWLEDGEBASE_DB='coyote3_knowledgebases'
BAM_DB='bam_dev'
ORGANIZATION_NAME='Coyote3'
LOCAL_TIME_ZONE='Europe/Stockholm'

# HTTP entrypoint. Web UI, API, docs, and public pages are exposed through nginx.
COYOTE3_PORT='6801'
SCRIPT_NAME=''
PUBLIC_BASE_URL='https://coyote3.example.org'

# Optional identity overrides. Container resource defaults and other runtime
# tuning values are documented in the environment reference; add them here
# only when this deployment needs to override the supported defaults.
COYOTE3_UID='10001'
COYOTE3_GID='10001'

# Redis cache behavior. The Redis URL is internal compose wiring, not a center
# env value. Set to `0` only for a deliberate degraded mode where cache misses
# are accepted when Redis is unavailable.
CACHE_REQUIRED='1'
CACHE_REDIS_CONNECT_TIMEOUT='1.0'
# Center input mounts belong in a private Compose override, not this base template.
# See deploy/compose/docker-compose.storage.example.yml.
CACHE_REDIS_SOCKET_TIMEOUT='1.0'

# API process and browser routing.
API_WORKERS='1'
# Trust only the ingress proxy IP or a dedicated proxy network CIDR, never '*'.
FORWARDED_ALLOW_IPS='127.0.0.1'
# Set https only when the external entry point enforces TLS.
COYOTE3_NGINX_PUBLIC_SCHEME='http'

# Logging. Session, retention, notification, and rate-limit defaults are
# documented and normally do not need environment overrides.
# Defaults: INFO for production/prod, DEBUG for other environments.
# Uncomment to override the environment default.
# LOG_LEVEL='INFO'

# Celery.
# Defaults to LOG_LEVEL; uncomment to override worker and beat logging.
# CELERY_LOG_LEVEL='INFO'

# Celery ingest watcher.
COYOTE3_INGEST_WATCH_ENABLED='0'
COYOTE3_INGEST_WATCH_FILENAME='coyote3.yaml'
COYOTE3_INGEST_DONE_SUFFIX='.done'
COYOTE3_INGEST_FAILED_SUFFIX='.failed'
COYOTE3_INGEST_WATCH_INTERVAL_SECONDS='30'
COYOTE3_INGEST_WATCH_UPDATE_EXISTING='0'
COYOTE3_INGEST_WATCH_INCREMENT='0'

# LDAP. Leave empty for local-only dev accounts; configure for center auth.
# Optional deployment override for the providers shown by the login page. It
# overrides [authentication].providers in api/config/center/clinical_vocabulary.toml.
# Use a comma-separated list such as 'local' or 'local,ldap'. When LDAP is
# enabled but the settings below are empty, the API still starts and LDAP login
# returns a configuration error.
AUTHENTICATION_PROVIDERS='local,ldap'
LDAP_HOST=''
# Empty port uses the URI port, otherwise 389 for LDAP or 636 for LDAPS.
LDAP_PORT=''
LDAP_USE_SSL='0'
LDAP_USE_TLS='1'
LDAP_VERIFY_CERT='1'
LDAP_CONNECT_TIMEOUT='10'
# Optional PEM CA bundle inside the API container. Empty uses system trust.
LDAP_CA_CERTS_FILE=''
LDAP_BASE_DN=''
LDAP_USER_LOGIN_ATTR='mail'
LDAP_BINDDN=''
LDAP_SECRET=''

# Optional center integrations.
GENS_URI=''
IGV_URI=''
# Workstation-visible root; use /R: for the mapped-drive layout, not the API mount.
IGV_DATA_ROOT='/R:'
ONCOKB_PUBLIC_LOOKUPS_ENABLED='1'
ONCOKB_REQUEST_TIMEOUT_SECONDS='3.0'
CLINPGX_PUBLIC_LOOKUPS_ENABLED='1'
CLINPGX_REQUEST_TIMEOUT_SECONDS='3.0'

# SMTP mail delivery.
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_USE_TLS='1'
SMTP_USE_SSL='0'
SMTP_FROM_EMAIL='no-reply@coyote3.local'
SMTP_INFO_FROM_EMAIL='info@coyote3.local'
SMTP_SECURITY_FROM_EMAIL='security@coyote3.local'
SMTP_FROM_NAME='Coyote3'
PASSWORD_TOKEN_TTL_SECONDS='3600'
