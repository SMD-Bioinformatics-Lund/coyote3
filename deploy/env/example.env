# Coyote3 environment template.
# Copy this file to the environment file consumed by your compose profile:
#   cp deploy/env/example.env .coyote3_dev_env
#   cp deploy/env/example.env .coyote3_stage_env
#   cp deploy/env/example.env .coyote3_test_env
#   cp deploy/env/example.env .coyote3_env
#
# Then set real secret values, database names, public URLs, ports, and paths for
# that environment. Local env files are ignored by git and must never be committed.

# Runtime identity
ENV_NAME='development'
COYOTE3_DB='coyote3_dev'
BAM_DB='BAM_Service'
ORGANIZATION_NAME='Coyote3'
LOCAL_TIME_ZONE='Europe/Stockholm'

# Core secrets. Generate unique values per environment before deployment.
SECRET_KEY='CHANGE_ME_SECRET_KEY'
INTERNAL_API_TOKEN='CHANGE_ME_INTERNAL_API_TOKEN'
API_SESSION_SALT='CHANGE_ME_API_SESSION_SALT'
PASSWORD_TOKEN_SALT='CHANGE_ME_PASSWORD_TOKEN_SALT'

# HTTP entrypoint. Web UI, API, docs, and public pages are exposed through nginx.
COYOTE3_PORT='6801'
SCRIPT_NAME='/coyote3_dev'
PUBLIC_BASE_URL='https://localhost'
CORS_ORIGINS='https://localhost'

# Optional container runtime limits.
COYOTE3_CONTAINER_MEM_LIMIT='2g'
COYOTE3_CONTAINER_CPU_LIMIT='2.0'

# MongoDB. By default containers can connect to host Mongo through
# host.docker.internal. If you use --profile with-mongo, point this URI at the
# compose Mongo service instead.
MONGO_ROOT_USERNAME='coyote3_root'
MONGO_ROOT_PASSWORD='CHANGE_ME_ROOT_PASSWORD'
MONGO_APP_USER='coyote3_app'
MONGO_APP_PASSWORD='CHANGE_ME_APP_PASSWORD'
MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:6804/coyote3_dev?authSource=coyote3_dev'

# Redis and cache behavior. The Redis URL is internal compose wiring, not a
# center env value.
CACHE_ENABLED='1'
CACHE_REQUIRED='0'
CACHE_REDIS_CONNECT_TIMEOUT='1.0'
CACHE_REDIS_SOCKET_TIMEOUT='1.0'
DASHBOARD_SUMMARY_CACHE_TTL_SECONDS='30'
DASHBOARD_SUMMARY_SNAPSHOT_MAX_AGE_SECONDS='120'
DASHBOARD_SUMMARY_SNAPSHOT_TTL_SECONDS='86400'

# API process and browser routing.
API_WORKERS='2'
APP_DNS='1.1.1.1'

# Sessions, audit, logging, notifications, and retention.
SESSION_COOKIE_SECURE='0'
API_SESSION_COOKIE_NAME='coyote3_dev_api_session'
API_SESSION_TTL_SECONDS='43200'
API_SESSION_COOKIE_SAMESITE='lax'
AUDIT_RETENTION_DAYS='730'
LOG_SERVICE_NAME='api'
LOG_FILE_ENABLED='1'
LOG_RETENTION_DAYS='30'
LOG_GZIP_AFTER_DAYS='1'
LOG_LEVEL='INFO'
NOTIFICATION_RETENTION_DAYS='180'

# Data mount used by reports, ingest staging, and watched manifests.
COYOTE3_DATA_HOST_ROOT='/data'
REPORTS_BASE_PATH='/data/coyote3/dev/reports'
CELERY_INGEST_STAGING_DIR='/data/coyote3/dev/ingest_staging'

# Celery.
CELERY_DEFAULT_QUEUE='default'
CELERY_INGEST_QUEUE='ingest'
CELERY_LOG_LEVEL='INFO'
CELERY_WORKER_CONCURRENCY='2'
CELERY_TASK_TIME_LIMIT='7200'
CELERY_TASK_SOFT_TIME_LIMIT='6900'
CELERY_RESULT_EXPIRES='86400'
CELERY_WORKER_PREFETCH_MULTIPLIER='1'
COYOTE3_MAINTENANCE_HOUR='2'

# Celery ingest watcher.
COYOTE3_INGEST_WATCH_ENABLED='0'
COYOTE3_INGEST_WATCH_DIR='/data/coyote3/dev/ingest'
COYOTE3_INGEST_WATCH_FILENAME='coyote3.yaml'
COYOTE3_INGEST_DONE_SUFFIX='.done'
COYOTE3_INGEST_FAILED_SUFFIX='.failed'
COYOTE3_INGEST_WATCH_INTERVAL_SECONDS='30'
COYOTE3_INGEST_WATCH_UPDATE_EXISTING='0'
COYOTE3_INGEST_WATCH_INCREMENT='0'

# LDAP. Leave empty for local-only dev accounts; configure for center auth.
LDAP_HOST=''
LDAP_BASE_DN=''
LDAP_USER_LOGIN_ATTR='mail'
LDAP_BINDDN=''
LDAP_SECRET=''
LDAP_USER_DN='ou=people'

# Optional center integrations.
GENS_URI=''
IGV_URI=''
KNOWLEDGEBASE_PLUGINS=''
ONCOKB_BASE_URL='https://public.api.oncokb.org/api/v1'
ONCOKB_PUBLIC_LOOKUPS_ENABLED='1'
ONCOKB_REQUEST_TIMEOUT_SECONDS='3.0'
ONCOKB_PUBLIC_BATCH_SIZE='200'
CLINPGX_BASE_URL='https://api.clinpgx.org/v1'
CLINPGX_PUBLIC_LOOKUPS_ENABLED='1'
CLINPGX_REQUEST_TIMEOUT_SECONDS='3.0'

# SMTP mail delivery.
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_USE_TLS='1'
SMTP_USE_SSL='0'
SMTP_FROM_EMAIL='noreply@coyote3.local'
SMTP_FROM_NAME='Coyote3'
PASSWORD_TOKEN_TTL_SECONDS='3600'

# Request rate limiting.
API_RATE_LIMIT_ENABLED='1'
API_RATE_LIMIT_REQUESTS_PER_MINUTE='600'
API_RATE_LIMIT_WINDOW_SECONDS='60'
WEB_RATE_LIMIT_ENABLED='1'
WEB_RATE_LIMIT_REQUESTS_PER_MINUTE='300'
WEB_RATE_LIMIT_WINDOW_SECONDS='60'
