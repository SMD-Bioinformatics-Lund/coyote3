# Application deployment example. Copy to a private file; never commit credentials.
#   cp deploy/env/example.env .coyote4_dev_env
# First installation: docs/deployment/first-installation.md
# All settings/defaults: docs/deployment/configuration-reference.md
# This example uses local HTTP. Review every value before a center deployment.

# Deployment identity and browser entry point.
# For production, select production, an HTTPS public origin and its proxy settings.
ENV_NAME='development'
COYOTE4_PORT='6801'
SCRIPT_NAME=''
PUBLIC_BASE_URL='http://localhost:6801'
API_SESSION_COOKIE_NAME='coyote4_dev_api_session'
ORGANIZATION_NAME='Coyote4'
LOCAL_TIME_ZONE='Europe/Stockholm'

# Four explicit MongoDB endpoints. These do not provision servers or users.
# Set actual reachable replica-set addresses and percent-encode URI passwords.
# Use example.mongo-local.env for host-run clients or example.mongo-split.env
# for separately provisioned Docker databases. Server settings are kept in
# example.mongo-server.env, not in this application file.
COYOTE4_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote4-rs'
IDENTITY_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote4-rs'
KNOWLEDGEBASE_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote4-rs'
BAM_MONGO_URI='mongodb://coyote4_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/?authSource=admin&replicaSet=coyote4-rs'
COYOTE4_DB='coyote4_dev'
IDENTITY_DB='coyote4_identity_dev'
KNOWLEDGEBASE_DB='coyote4_knowledgebases'
BAM_DB='coyote4_bam_dev'

# Unique secrets per deployment, each at least 16 characters.
SECRET_KEY='CHANGE_ME_SECRET_KEY'
INTERNAL_API_TOKEN='CHANGE_ME_INTERNAL_API_TOKEN'
PASSWORD_TOKEN_SALT='CHANGE_ME_PASSWORD_TOKEN_SALT'

# Redis runs independently. Use 127.0.0.1 for native clients, redis on a shared
# Docker network, or host.docker.internal for Docker clients of a native server.
# Percent-encode credentials. Server setup uses example.redis-server.env.
CACHE_REDIS_URL='redis://:CHANGE_ME_REDIS_SECRET@redis:6379/0'
CELERY_BROKER_URL='redis://:CHANGE_ME_REDIS_SECRET@redis:6379/1'
CELERY_RESULT_BACKEND='redis://:CHANGE_ME_REDIS_SECRET@redis:6379/2'

# Persistent host paths and pre-created Docker network.
# Copy and review the center examples before pointing at this directory.
COYOTE4_DATA_HOST_ROOT='/data/coyote4'
COYOTE4_LOGS_HOST_ROOT='/srv/coyote4/logs'
COYOTE4_CENTER_CONFIG_HOST_DIR='/srv/coyote4/center-config'
COYOTE4_APP_NETWORK='coyote4-dev-app-net'

# Optional integrations: add settings only for services this deployment uses.
# AUTHENTICATION_PROVIDERS, LDAP_*, SMTP_*: authentication/mail configuration.
# GENS_URI, IGV_URI, IGV_DATA_ROOT: center browser integrations.
# Resource limits, cache, timeouts, logging and ingest-watcher settings inherit
# the maintained application/Compose defaults unless explicitly overridden.
# See the environment reference for keys, requirements and omission behavior.
# Extra input mounts belong in a private Compose storage override.
