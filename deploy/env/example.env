# Coyote3 environment template.
# Copy this file to the environment file consumed by your compose profile:
#   cp deploy/env/example.env .coyote3_dev_env
#   cp deploy/env/example.env .coyote3_stage_env
#   cp deploy/env/example.env .coyote3_test_env
#   cp deploy/env/example.env .coyote3_env
#
# Values in the first section are the deployment contract and must be reviewed
# by every center. Remaining values have supported defaults and normally need
# no change. Local env files are ignored by git and must never be committed.

# Required deployment values
# --------------------------
# Use unique secrets per environment. MONGO_URI must be reachable from the API,
# worker, and beat containers. CORS_ORIGINS must contain the browser-facing
# origin. The application network must be created before Compose starts. The
# two host roots must already exist and be writable by 10001:10001, unless
# COYOTE3_UID/COYOTE3_GID are deliberately overridden below.
MONGO_URI='mongodb://coyote3_app:CHANGE_ME_APP_PASSWORD@host.docker.internal:27017/coyote3?authSource=coyote3'
SECRET_KEY='CHANGE_ME_SECRET_KEY'
INTERNAL_API_TOKEN='CHANGE_ME_INTERNAL_API_TOKEN'
PASSWORD_TOKEN_SALT='CHANGE_ME_PASSWORD_TOKEN_SALT'
CORS_ORIGINS='https://coyote3.example.org'
COYOTE3_DATA_HOST_ROOT='/srv/coyote3/data'
COYOTE3_LOGS_HOST_ROOT='/srv/coyote3/logs'
COYOTE3_APP_NETWORK='coyote3-prod-app-net'

# Supported application defaults
# ------------------------------
# Change ENV_NAME for test, validation, or production. Set SCRIPT_NAME only
# when publishing below a URL prefix. PUBLIC_BASE_URL is needed when Coyote3
# creates links outside a browser request, including password-reset email.

# Runtime identity
ENV_NAME='development'
COYOTE3_DB='coyote3'
IDENTITY_DB='coyote3_identity'
KNOWLEDGEBASE_DB='coyote3_knowledgebase'
BAM_DB='BAM_Service'
ORGANIZATION_NAME='Coyote3'
LOCAL_TIME_ZONE='Europe/Stockholm'

# HTTP entrypoint. Web UI, API, docs, and public pages are exposed through nginx.
COYOTE3_PORT='6801'
SCRIPT_NAME=''
PUBLIC_BASE_URL='https://coyote3.example.org'

# Optional identity overrides. Container resource defaults and other runtime
# tuning values are documented in the environment reference; add them here
# only when this deployment needs to override the supported defaults.
COYOTE3_UID='10001'
COYOTE3_GID='10001'

# MongoDB. The application always connects only through MONGO_URI. It does not
# create MongoDB containers, networks, users, or replica sets. A center may use
# a host-installed service, a managed service, or an independently deployed
# Docker service, provided that this URI is reachable from application containers.
MONGO_ROOT_USERNAME='coyote3_root'
MONGO_ROOT_PASSWORD='CHANGE_ME_ROOT_PASSWORD'
MONGO_APP_USER='coyote3_app'
MONGO_APP_PASSWORD='CHANGE_ME_APP_PASSWORD'
MONGO_REPLICA_SET_NAME='coyote3-rs'
MONGO_REPLICA_MEMBER_HOST='host.docker.internal:27017'
COYOTE3_MONGO_PORT='27017'
COYOTE3_MONGO_BIND_ADDRESS='127.0.0.1'
COYOTE3_MONGO_NETWORK='coyote3-mongo-net'
COYOTE3_MONGO_NETWORK_SUBNET='172.29.100.0/29'
COYOTE3_MONGO_NETWORK_GATEWAY='172.29.100.1'

# Redis cache behavior. The Redis URL is internal compose wiring, not a center
# env value. Set to `0` only for a deliberate degraded mode where cache misses
# are accepted when Redis is unavailable.
CACHE_REQUIRED='1'
CACHE_REDIS_CONNECT_TIMEOUT='1.0'
CACHE_REDIS_SOCKET_TIMEOUT='1.0'

# API process and browser routing.
API_WORKERS='1'
APP_DNS='1.1.1.1'

# Logging. Session, retention, notification, and rate-limit defaults are
# documented and normally do not need environment overrides.
LOG_LEVEL='INFO'

# Host storage roots. Container destinations remain fixed application contracts:
# data at /data, JSONL logs at /app/logs, MongoDB data at /data/db, and
# MongoDB backups at /backup. The MongoDB keyfile is a persistent secret file
# used for replica-set member authentication; create it before first startup.
COYOTE3_MONGO_DATA_HOST_ROOT='/srv/coyote3/mongo/data'
COYOTE3_MONGO_BACKUP_HOST_ROOT='/srv/coyote3/mongo/backups'
COYOTE3_MONGO_KEYFILE_HOST_PATH='/srv/coyote3/mongo/keyfile'

# Celery.
CELERY_LOG_LEVEL='INFO'

# Celery ingest watcher.
COYOTE3_INGEST_WATCH_ENABLED='0'
COYOTE3_INGEST_WATCH_FILENAME='coyote3.yaml'
COYOTE3_INGEST_DONE_SUFFIX='.done'
COYOTE3_INGEST_FAILED_SUFFIX='.failed'
COYOTE3_INGEST_WATCH_INTERVAL_SECONDS='30'
COYOTE3_INGEST_WATCH_UPDATE_EXISTING='0'
COYOTE3_INGEST_WATCH_INCREMENT='0'

# LDAP. Leave empty for local-only dev accounts; configure for center auth.
# Optional deployment override for the providers shown by the login page. It
# overrides [authentication].providers in api/config/center/clinical_vocabulary.toml.
# Use a comma-separated list such as 'local' or 'local,ldap'. When LDAP is
# enabled but the settings below are empty, the API still starts and LDAP login
# returns a configuration error.
AUTHENTICATION_PROVIDERS='local,ldap'
LDAP_HOST=''
LDAP_BASE_DN=''
LDAP_USER_LOGIN_ATTR='mail'
LDAP_BINDDN=''
LDAP_SECRET=''
LDAP_USER_DN='ou=people'

# Optional center integrations.
GENS_URI=''
IGV_URI=''
ONCOKB_PUBLIC_LOOKUPS_ENABLED='1'
ONCOKB_REQUEST_TIMEOUT_SECONDS='3.0'
CLINPGX_PUBLIC_LOOKUPS_ENABLED='1'
CLINPGX_REQUEST_TIMEOUT_SECONDS='3.0'

# SMTP mail delivery.
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_USE_TLS='1'
SMTP_USE_SSL='0'
SMTP_FROM_EMAIL='noreply@coyote3.local'
SMTP_FROM_NAME='Coyote3'
PASSWORD_TOKEN_TTL_SECONDS='3600'

# Public web-route rate limiting. API rate limiting, CSRF protection, and
# MongoDB client defaults are documented and should be overridden only for a
# reviewed deployment requirement.
WEB_RATE_LIMIT_ENABLED='1'
WEB_RATE_LIMIT_REQUESTS_PER_MINUTE='300'
WEB_RATE_LIMIT_WINDOW_SECONDS='60'
