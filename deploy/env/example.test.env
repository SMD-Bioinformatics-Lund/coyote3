# Testing environment template.
# Copy to .coyote3_test_env for test-stack and CI-like local runs.

# Core app secrets (test-only placeholders)
SECRET_KEY='ci-test-secret-key'
INTERNAL_API_TOKEN='ci-test-internal-token'
API_SESSION_SALT='ci-test-session-salt'
PASSWORD_TOKEN_SALT='ci-test-password-token-salt'

# Runtime identity
ENV_NAME='test'
COYOTE3_DB='coyote3_test'
SESSION_COOKIE_NAME='coyote3_test'
API_SESSION_COOKIE_NAME='coyote3_test_api_session'
API_SESSION_COOKIE_SAMESITE='lax'
API_SESSIONS_COLLECTION='api_sessions'
AUDIT_EVENTS_COLLECTION='audit_events'
AUDIT_RETENTION_DAYS='730'
LOG_SERVICE_NAME='api'
LOG_FILE_ENABLED='0'
LOG_RETENTION_DAYS='7'
LOG_LEVEL='INFO'
SCRIPT_NAME='/coyote3_test'

# MongoDB. By default containers connect through the host so this file also
# works when Mongo is local/external. Start compose Mongo with --profile with-mongo.
MONGO_ROOT_USERNAME='coyote3_root'
MONGO_ROOT_PASSWORD='CHANGE_ME_TEST_ROOT_PASSWORD'
MONGO_APP_USER='coyote3_app'
MONGO_APP_PASSWORD='CHANGE_ME_TEST_APP_PASSWORD'
MONGO_URI='mongodb://coyote3_app:CHANGE_ME_TEST_APP_PASSWORD@host.docker.internal:6814/coyote3_test?authSource=coyote3_test'
COYOTE3_TEST_MONGO_PORT='6814'

# Redis
CACHE_REDIS_URL='redis://coyote3_redis_test:6379/0'
DASHBOARD_SUMMARY_CACHE_TTL_SECONDS='15'
DASHBOARD_SUMMARY_SNAPSHOT_MAX_AGE_SECONDS='60'
DASHBOARD_SUMMARY_SNAPSHOT_TTL_SECONDS='86400'

# Host port mapping (compose reverse proxy)
COYOTE3_TEST_PORT='6811'

# Host/container data mount used by reports, ingest staging, and watched manifests.
COYOTE3_DATA_HOST_ROOT='/data'
COYOTE3_DATA_CONTAINER_ROOT='/data'

# Optional container runtime limits
COYOTE3_TEST_CONTAINER_MEM_LIMIT='2g'
COYOTE3_TEST_CONTAINER_CPU_LIMIT='2.0'

# Build metadata (optional)
COYOTE3_VERSION='test-local'
GIT_COMMIT='unknown'
BUILD_TIME='unknown'
API_WORKERS='2'

# App behavior
FLASK_DEBUG='0'
DEVELOPMENT='0'
TESTING='1'
APP_DNS='1.1.1.1'
REPORTS_BASE_PATH='/data/coyote3/test/reports'

# Celery ingest watcher
CELERY_INGEST_STAGING_DIR='/data/coyote3/test/ingest_staging'
COYOTE3_INGEST_WATCH_ENABLED='0'
COYOTE3_INGEST_WATCH_DIR='/data/coyote3/test/ingest'
COYOTE3_INGEST_WATCH_FILENAME='coyote3.yaml'
COYOTE3_INGEST_DONE_SUFFIX='.done'
COYOTE3_INGEST_FAILED_SUFFIX='.failed'
COYOTE3_INGEST_WATCH_INTERVAL_SECONDS='30'
COYOTE3_INGEST_WATCH_UPDATE_EXISTING='0'
COYOTE3_INGEST_WATCH_INCREMENT='0'

# LDAP (test — disabled, using local auth)
LDAP_HOST=''
LDAP_SECRET=''
CORS_ORIGINS='http://localhost:6811'

# Center contact information
CONTACT_CLINICAL_EMAIL=''
CONTACT_RESEARCH_EMAIL=''
CONTACT_SAMPLES_EMAIL=''
CONTACT_PHONE_MAIN=''
CONTACT_PHONE_URGENT=''
CONTACT_ADDRESS=''

# Optional integrations
GENS_URI_OLD=''
GENS_URI=''
IGV_URI=''

# SMTP mail delivery (org relay mode)
SMTP_HOST='mxis.skane.se'
SMTP_PORT='25'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_USE_TLS='0'
SMTP_USE_SSL='0'
SMTP_FROM_EMAIL='noreply@coyote3.local'
SMTP_FROM_NAME='Coyote3'
WEB_APP_BASE_URL='http://localhost:6811/coyote3_test'
HELP_CENTER_URL='http://localhost:6815/'
PASSWORD_TOKEN_TTL_SECONDS='3600'

# Request rate limiting
API_RATE_LIMIT_ENABLED='1'
API_RATE_LIMIT_REQUESTS_PER_MINUTE='600'
API_RATE_LIMIT_WINDOW_SECONDS='60'
WEB_RATE_LIMIT_ENABLED='1'
WEB_RATE_LIMIT_REQUESTS_PER_MINUTE='300'
WEB_RATE_LIMIT_WINDOW_SECONDS='60'
